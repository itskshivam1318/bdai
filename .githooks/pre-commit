#!/usr/bin/env bash
# Typecheck the tree you are about to commit -- not the one on your disk.
#
# The bug this exists for: `d7270e8` committed a `SessionView` passing a prop to
# a `StageRail` that was still uncommitted in a concurrent session sharing this
# worktree. `make check` passed, because the working tree had both halves.
# Checked out on its own, HEAD did not compile, and nothing said so for two
# commits.
#
# `git add <file>` stages the file *as it is now*, not the edits you made. With
# a second writer in the same worktree those differ, and the working tree hides
# the difference. So this checks the index -- `git checkout-index` materialises
# exactly the tree the commit would create -- and never the files on disk.
#
# Escape hatch: `git commit --no-verify`. Use it for a WIP commit you intend to
# amend, not to get past a real failure.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SCRATCH="$ROOT/app/.precommit"
TREE="$SCRATCH/tree"

staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }

WEB=$(staged 'app/web/*.ts' 'app/web/*.tsx')
API=$(staged 'app/api/*.py')

if [ -z "$WEB" ] && [ -z "$API" ]; then
  exit 0
fi

echo "pre-commit: materialising the staged tree…"
rm -rf "$TREE"
mkdir -p "$TREE"
# The index is the would-be commit. Unstaged edits are absent from it by
# construction, which is the whole point.
git checkout-index -a -f --prefix="$TREE/"

status=0

if [ -n "$WEB" ]; then
  # node_modules is not in the index. `cp -c` clones copy-on-write on APFS --
  # the same call scripts/worktree.sh makes, and for the same reason: a
  # symlinked node_modules is rejected by Turbopack, and `npm install` costs a
  # minute. Falls back to a symlink, which tsc tolerates even though `next dev`
  # would not.
  if ! cp -Rc "$ROOT/app/web/node_modules" "$TREE/app/web/node_modules" 2>/dev/null; then
    ln -s "$ROOT/app/web/node_modules" "$TREE/app/web/node_modules"
  fi

  # `next-env.d.ts` and `.next/dev/types/` are generated by `next dev` and are
  # gitignored, so a materialised tree has neither -- and without them every
  # run reports `Cannot find name 'LayoutProps'`, which is about the checkout
  # and not about the commit. Carried in so a failure here always means the
  # commit is genuinely broken.
  cp "$ROOT/app/web/next-env.d.ts" "$TREE/app/web/" 2>/dev/null || true
  if [ -d "$ROOT/app/web/.next/dev/types" ]; then
    mkdir -p "$TREE/app/web/.next/dev"
    cp -R "$ROOT/app/web/.next/dev/types" "$TREE/app/web/.next/dev/"
  fi

  echo "pre-commit: tsc on the staged tree…"
  if ! ( cd "$TREE/app/web" && npx tsc --noEmit -p . ); then
    echo
    echo "REFUSED: the staged tree does not typecheck."
    echo "  Your working tree may still compile -- that means a file this commit"
    echo "  depends on is edited but NOT staged. Stage it too, or drop the part"
    echo "  of your change that reaches for it."
    status=1
  fi
fi

if [ -n "$API" ] && [ $status -eq 0 ]; then
  # Import-only, using the real venv's interpreter against the staged sources:
  # enough to catch a router staged without the model it imports, which is the
  # same failure in the other language.
  #
  # `cd` into the staged tree rather than setting PYTHONPATH from outside it.
  # With `python -c`, sys.path[0] is the working directory, so running from the
  # real `app/api` imports the real modules and the staged ones are shadowed --
  # this check silently passed on a deliberately broken index until it ran from
  # the right place. The venv's interpreter is addressed absolutely, so it does
  # not care where it is invoked from.
  echo "pre-commit: importing the staged API…"
  PY_BIN="$ROOT/app/api/.venv/bin/python"
  [ -x "$PY_BIN" ] || PY_BIN="python3"
  if ! ( cd "$TREE/app/api" && "$PY_BIN" -c "import app.main" ); then
    echo
    echo "REFUSED: the staged API does not import."
    echo "  Same cause as above: something it needs is edited but not staged."
    status=1
  fi
fi

[ $status -eq 0 ] && echo "pre-commit: staged tree is sound."
exit $status
